# Frontend (Vite) - copy to .env.local for local development.
# Only variables prefixed with VITE_ are exposed to the browser, so never put secrets here.
VITE_API_URL=https://xrmtrmaxgsesmsdujbbq.supabase.co/functions/v1/analyze

